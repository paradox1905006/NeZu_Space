<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row built in code (Privacy & Security): optional icon, title, summary, optional switch. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Nezu.PrefRow">

    <ImageView
        android:id="@+id/ivPrefIcon"
        style="@style/Widget.Nezu.PrefRow.Icon"
        android:visibility="gone" />

    <LinearLayout style="@style/Widget.Nezu.PrefRow.Text">
        <TextView
            android:id="@+id/tvPrefTitle"
            style="@style/Widget.Nezu.PrefRow.Title" />
        <TextView
            android:id="@+id/tvPrefHint"
            style="@style/Widget.Nezu.PrefRow.Summary" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchPref"
        style="@style/Widget.Nezu.PrefRow.Switch" />
</LinearLayout>
