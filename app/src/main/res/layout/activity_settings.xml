<?xml version="1.0" encoding="utf-8"?>
<!-- Root has no background on purpose: the window background (colour + custom picture) shows through. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                style="?attr/collapsingToolbarLayoutLargeStyle"
                android:layout_width="match_parent"
                android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
                app:contentScrim="@android:color/transparent"
                app:expandedTitleMarginStart="24dp"
                app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
                app:statusBarScrim="@android:color/transparent"
                app:title="Settings">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    android:elevation="0dp"
                    app:layout_collapseMode="pin"
                    app:navigationContentDescription="Back"
                    app:navigationIcon="@drawable/ic_back" />
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="40dp">

            <!-- ═══ App identity ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Nezu.Squircle" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NeZu Space"
                        android:textAppearance="@style/TextAppearance.Nezu.Brand"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="24sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Private, isolated multi-profile browser"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnPrimaryContainer" />
                    <TextView
                        android:id="@+id/tvVersion"
                        style="@style/Widget.Nezu.Pill"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="?attr/colorSurfaceContainerLowest"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/Widget.Nezu.SectionHeader" android:text="Appearance" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Nezu.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">
                    <LinearLayout
                        style="@style/Widget.Nezu.PrefRow"
                        android:background="@null"
                        android:orientation="vertical"
                        android:gravity="start">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView style="@style/Widget.Nezu.PrefRow.Icon" android:src="@drawable/ic_contrast" />
                            <LinearLayout style="@style/Widget.Nezu.PrefRow.Text">
                                <TextView style="@style/Widget.Nezu.PrefRow.Title" android:text="Theme" />
                                <TextView style="@style/Widget.Nezu.PrefRow.Summary" android:text="Follow the phone, or always light or dark" />
                            </LinearLayout>
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/themeGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnThemeSystem"
                                style="?attr/materialButtonOutlinedStyle"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Auto"
                                android:contentDescription="System theme"
                                app:icon="@drawable/ic_auto_mode"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="18dp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnThemeLight"
                                style="?attr/materialButtonOutlinedStyle"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Light"
                                app:icon="@drawable/ic_light_mode"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="18dp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnThemeDark"
                                style="?attr/materialButtonOutlinedStyle"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Dark"
                                app:icon="@drawable/ic_dark_mode"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="18dp" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowDynamic"
                        style="@style/Widget.Nezu.PrefRow">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon" android:src="@drawable/ic_palette" />
                        <LinearLayout style="@style/Widget.Nezu.PrefRow.Text">
                            <TextView style="@style/Widget.Nezu.PrefRow.Title" android:text="Material You colours" />
                            <TextView
                            android:id="@+id/tvDynamicHint"
                                style="@style/Widget.Nezu.PrefRow.Summary"
                                android:text="Use colours from your wallpaper (Android 12+)" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchDynamic"
                            style="@style/Widget.Nezu.PrefRow.Switch" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowAnimations"
                        style="@style/Widget.Nezu.PrefRow">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon" android:src="@drawable/ic_animation" />
                        <LinearLayout style="@style/Widget.Nezu.PrefRow.Text">
                            <TextView style="@style/Widget.Nezu.PrefRow.Title" android:text="Animations" />
                            <TextView
                                style="@style/Widget.Nezu.PrefRow.Summary"
                                android:text="Page turn when changing tab or profile, dust when closing or creating" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAnimations"
                            style="@style/Widget.Nezu.PrefRow.Switch" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowAdBlock"
                        style="@style/Widget.Nezu.PrefRow">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon.Secondary" android:src="@drawable/ic_ad_off" />
                        <LinearLayout style="@style/Widget.Nezu.PrefRow.Text">
                            <TextView style="@style/Widget.Nezu.PrefRow.Title" android:text="Ad blocker" />
                            <TextView
                                style="@style/Widget.Nezu.PrefRow.Summary"
                                android:text="Blocks known ad and tracker servers and hides empty ad boxes" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAdBlock"
                            style="@style/Widget.Nezu.PrefRow.Switch" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowKeepAwake"
                        style="@style/Widget.Nezu.PrefRow"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon.Secondary" android:src="@drawable/ic_timer" />
                        <LinearLayout style="@style/Widget.Nezu.PrefRow.Text">
                            <TextView style="@style/Widget.Nezu.PrefRow.Title" android:text="Don't sleep" />
                            <TextView
                                android:id="@+id/tvKeepAwake"
                                style="@style/Widget.Nezu.PrefRow.Value" />
                            <TextView style="@style/Widget.Nezu.PrefRow.Summary" android:text="Keeps the screen on while NeZu Space is open" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView style="@style/Widget.Nezu.SectionHeader" android:text="Privacy &amp; security" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Nezu.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:id="@+id/privacyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView style="@style/Widget.Nezu.SectionHeader" android:text="Extensions" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Nezu.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:id="@+id/extensionList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp" />
            </com.google.android.material.card.MaterialCardView>
            <TextView style="@style/Widget.Nezu.SectionHeader" android:text="Sounds" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Nezu.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">
                    <LinearLayout
                        android:id="@+id/rowSoundMaster"
                        style="@style/Widget.Nezu.PrefRow">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon.Tertiary" android:src="@drawable/ic_volume" />
                        <LinearLayout style="@style/Widget.Nezu.PrefRow.Text">
                            <TextView style="@style/Widget.Nezu.PrefRow.Title" android:text="Sound effects" />
                            <TextView
                                style="@style/Widget.Nezu.PrefRow.Summary"
                                android:text="Master switch for all sounds below" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchSoundMaster"
                            style="@style/Widget.Nezu.PrefRow.Switch" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/soundList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView style="@style/Widget.Nezu.SectionHeader" android:text="Background" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Nezu.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/bgPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/colorSurfaceContainerHighest"
                            android:contentDescription="Background preview"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Nezu.Medium" />
                        <TextView
                            android:id="@+id/tvNoPicture"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:drawableTop="@drawable/ic_wallpaper"
                            android:drawablePadding="8dp"
                            android:drawableTint="?attr/colorOnSurfaceVariant"
                            android:gravity="center"
                            android:text="No background selected"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickBg"
                            style="@style/Widget.Material3.Button.Icon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Choose picture, GIF or video"
                            app:icon="@drawable/ic_image" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRemoveBg"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="Remove background"
                            android:text="Remove" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.Nezu.PrefRow"
                        android:background="@null"
                        android:paddingBottom="0dp">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon" android:src="@drawable/ic_opacity" />
                        <TextView
                            style="@style/Widget.Nezu.PrefRow.Title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Picture opacity" />
                        <TextView
                            android:id="@+id/tvOpacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderOpacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Picture opacity"
                        android:stepSize="5"
                        app:tickVisible="false"
                        android:valueFrom="0"
                        android:valueTo="100" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="72dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="8dp"
                        android:text="Low = faint picture, high = vivid picture. Bars and sheets stay slightly see-through so the picture shows behind them."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <LinearLayout
                        android:id="@+id/rowWebTransparent"
                        style="@style/Widget.Nezu.PrefRow">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon.Secondary" android:src="@drawable/ic_web" />
                        <LinearLayout style="@style/Widget.Nezu.PrefRow.Text">
                            <TextView style="@style/Widget.Nezu.PrefRow.Title" android:text="Show behind web pages" />
                            <TextView
                                style="@style/Widget.Nezu.PrefRow.Summary"
                                android:text="Only pages with no background of their own. Text can be hard to read." />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchWebTransparent"
                            style="@style/Widget.Nezu.PrefRow.Switch" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowVideoSound"
                        style="@style/Widget.Nezu.PrefRow"
                        android:visibility="gone">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon.Tertiary" android:src="@drawable/ic_videocam" />
                        <LinearLayout style="@style/Widget.Nezu.PrefRow.Text">
                            <TextView style="@style/Widget.Nezu.PrefRow.Title" android:text="Video sound" />
                            <TextView
                                style="@style/Widget.Nezu.PrefRow.Summary"
                                android:text="Play the sound of the background video. Off keeps it silent." />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchVideoSound"
                            style="@style/Widget.Nezu.PrefRow.Switch" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView style="@style/Widget.Nezu.SectionHeader" android:text="Help" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Nezu.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">
                    <LinearLayout
                        android:id="@+id/rowGuide"
                        style="@style/Widget.Nezu.PrefRow"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon" android:src="@drawable/ic_menu_book" />
                        <LinearLayout style="@style/Widget.Nezu.PrefRow.Text">
                            <TextView style="@style/Widget.Nezu.PrefRow.Title" android:text="How to use NeZu Space" />
                            <TextView style="@style/Widget.Nezu.PrefRow.Summary" android:text="Tabs, profiles, bookmarks, downloads, cookies and more" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView style="@style/Widget.Nezu.SectionHeader" android:text="About" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Nezu.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">
                    <LinearLayout
                        style="@style/Widget.Nezu.PrefRow"
                        android:minHeight="64dp"
                        android:background="@null">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon.Secondary" android:src="@drawable/ic_code" />
                        <TextView
                            style="@style/Widget.Nezu.PrefRow.Title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Developer" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="D.Paradox"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowTelegram"
                        style="@style/Widget.Nezu.PrefRow"
                        android:minHeight="64dp">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon.Secondary" android:src="@drawable/ic_send" />
                        <TextView
                            style="@style/Widget.Nezu.PrefRow.Title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Telegram" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@Parad0x1905006"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowChannel"
                        style="@style/Widget.Nezu.PrefRow"
                        android:minHeight="64dp">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon.Secondary" android:src="@drawable/ic_send" />
                        <TextView
                            style="@style/Widget.Nezu.PrefRow.Title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Official Telegram channel" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@paradoxical_store"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Widget.Nezu.PrefRow"
                        android:minHeight="64dp"
                        android:background="@null">
                        <ImageView style="@style/Widget.Nezu.PrefRow.Icon.Secondary" android:src="@drawable/ic_language" />
                        <TextView
                            style="@style/Widget.Nezu.PrefRow.Title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Language" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="English"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:drawableTop="@drawable/ic_favorite_small"
                android:drawablePadding="6dp"
                android:drawableTint="?attr/colorPrimary"
                android:gravity="center"
                android:text="Made by D.Paradox"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
